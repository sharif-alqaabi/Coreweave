# Model provider: set ONE of these. W&B Inference works with just the W&B key (no Anthropic key needed).
WANDB_API_KEY=
WANDB_ENTITY=matthewma003-san-jose-state-university
WANDB_PROJECT=helix
WANDB_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507     # any id from https://wandb.ai/inference
# LLM_PROVIDER=wandb | anthropic | openai   (auto: anthropic if ANTHROPIC_API_KEY set, else wandb)
ANTHROPIC_API_KEY=
# CRITIC_MODEL= / ARCHITECT_MODEL=   optional per-role overrides
# Novelty check (helix/replicate.py, Lead Lab): TypeSafe key from https://console.typesafe.ai/
TYPESAFE_API_KEY=
# LLM_PROVIDER=litellm with LITELLM_MODEL=openai/Qwen/Qwen3-235B-A22B-Instruct-2507 routes through LiteLLM to W&B Inference;
# anthropic/claude-sonnet-5 or ollama/llama3 work the same way.
# LITELLM_MODEL=
# HELIX_EMBEDDINGS=minishlab/potion-base-8M     # model2vec model for the graph's semantic candidate pool
# HELIX_NER=regex                               # gliner: zero-shot entity tagging (pip install gliner; needs torch)
